{
  "openapi": "3.1.0",
  "info": {
    "title": "dipeat API",
    "description": "찍먹 — 메뉴판 사진 한 장을 구조화된 메뉴로",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "헬스체크 + Cloud Run 워밍업",
        "description": "발표 직전 이 엔드포인트를 한 번 때려 인스턴스를 깨워둔다.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu/scan": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "메뉴판 사진 1장 → 구조화된 메뉴",
        "operationId": "scan_menu_api_v1_menu_scan_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_menu_api_v1_menu_scan_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuScanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_scan_menu_api_v1_menu_scan_post": {
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "title": "Image",
            "description": "메뉴판 사진 (JPEG/PNG/WEBP)"
          },
          "mode": {
            "type": "string",
            "enum": [
              "poster",
              "booklet",
              "kiosk"
            ],
            "title": "Mode",
            "description": "촬영 모드",
            "default": "poster"
          },
          "target_lang": {
            "type": "string",
            "title": "Target Lang",
            "description": "번역 대상 언어",
            "default": "ko"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_scan_menu_api_v1_menu_scan_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "has_api_key": {
            "type": "boolean",
            "title": "Has Api Key"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model",
          "has_api_key"
        ],
        "title": "Health"
      },
      "LikelyAllergen": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "egg",
              "milk",
              "buckwheat",
              "peanut",
              "soy",
              "wheat",
              "gluten",
              "mackerel",
              "fish",
              "crab",
              "shrimp",
              "crustacean",
              "squid",
              "shellfish",
              "mollusk",
              "pork",
              "beef",
              "chicken",
              "peach",
              "tomato",
              "sulfite",
              "walnut",
              "pine_nut",
              "tree_nut",
              "sesame",
              "celery",
              "mustard",
              "alcohol",
              "other"
            ],
            "title": "Code",
            "description": "표준 알레르기 코드"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "한국어 표시명. 예: '새우'"
          },
          "inferred": {
            "type": "boolean",
            "title": "Inferred",
            "description": "메뉴판에 명시돼 있지 않고 요리 지식으로 추론했으면 true. 대부분 true 다."
          },
          "basis": {
            "type": "string",
            "title": "Basis",
            "description": "그렇게 판단한 근거를 한국어 한 문장으로. 예: \"메뉴명에 'エビ'(새우)가 있음\""
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence",
            "description": "확신도"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label",
          "inferred",
          "basis",
          "confidence"
        ],
        "title": "LikelyAllergen",
        "description": "⚠️ 메뉴판에서 '읽은' 사실이 아니라 요리 지식에서 '추론한' 값이다.\n\nUI 는 반드시 추정임을 고지해야 한다. 식품 안전 문제라 이 구분이 중요하다."
      },
      "MenuItem": {
        "properties": {
          "name_local": {
            "type": "string",
            "title": "Name Local",
            "description": "메뉴판에 적힌 원문 그대로. 절대 번역·정규화하지 말 것. 읽은 글자만."
          },
          "name_translated": {
            "type": "string",
            "title": "Name Translated",
            "description": "한국어 번역명. 음차가 자연스러우면 음차."
          },
          "romanization": {
            "type": "string",
            "title": "Romanization",
            "description": "로마자 표기. 없으면 빈 문자열."
          },
          "price_text": {
            "type": "string",
            "title": "Price Text",
            "description": "가격을 적힌 그대로. 예: '970円', '¥970', '時価'. 못 읽었으면 빈 문자열."
          },
          "price_amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Amount",
            "description": "price_text 에서 파싱한 숫자만. 범위·시가·판독 불가면 null."
          },
          "tax_included": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Included",
            "description": "税込이면 true, 税抜/+税면 false, 표기가 없으면 null."
          },
          "category": {
            "type": "string",
            "enum": [
              "food",
              "drink",
              "dessert",
              "set",
              "unknown"
            ],
            "title": "Category",
            "description": "분류"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "한국인 여행자가 처음 봐도 알 수 있게 2~3문장. 맛·식감·먹는 법 위주. 메뉴판에 설명이 없으면 요리 일반 지식으로 채우되 지어내지 말 것."
          },
          "tags": {
            "items": {
              "type": "string",
              "enum": [
                "signature",
                "local",
                "caution",
                "spicy",
                "raw",
                "vegetarian",
                "vegan",
                "pork",
                "beef",
                "chicken",
                "seafood",
                "alcohol",
                "share",
                "single_portion",
                "noodle",
                "rice",
                "soup",
                "fried",
                "dessert"
              ]
            },
            "type": "array",
            "title": "Tags",
            "description": "해당하는 것만. 없으면 빈 배열."
          },
          "likely_allergens": {
            "items": {
              "$ref": "#/components/schemas/LikelyAllergen"
            },
            "type": "array",
            "title": "Likely Allergens",
            "description": "메뉴명·재료로 정당화할 수 있는 것만. 근거를 댈 수 없으면 넣지 말 것. 억지로 채우지 말고, 확실하지 않으면 confidence 를 낮출 것."
          },
          "ocr_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Ocr Confidence",
            "description": "이 항목의 글자를 얼마나 확실히 읽었는지"
          }
        },
        "type": "object",
        "required": [
          "name_local",
          "name_translated",
          "romanization",
          "price_text",
          "price_amount",
          "tax_included",
          "category",
          "description",
          "tags",
          "likely_allergens",
          "ocr_confidence"
        ],
        "title": "MenuItem"
      },
      "MenuScanResponse": {
        "properties": {
          "source_lang": {
            "type": "string",
            "title": "Source Lang",
            "description": "메뉴판 언어의 BCP-47 코드. 예: 'ja', 'th', 'vi'"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "ISO 4217 통화 코드. 예: 'JPY'. 모르면 빈 문자열."
          },
          "restaurant": {
            "$ref": "#/components/schemas/Restaurant"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            },
            "type": "array",
            "title": "Items",
            "description": "메뉴판에서 읽은 항목 전부. 사진에 없는 메뉴를 지어내지 말 것. 카테고리 제목(예: '一品料理')은 항목이 아니므로 제외."
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "사용자에게 알려야 할 문제를 한국어로. 예: '메뉴판 오른쪽이 잘려 일부를 읽지 못했어요'. 문제가 없으면 빈 배열."
          },
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "meta": {
            "$ref": "#/components/schemas/ScanMeta"
          }
        },
        "type": "object",
        "required": [
          "source_lang",
          "currency",
          "restaurant",
          "items",
          "warnings",
          "scan_id",
          "meta"
        ],
        "title": "MenuScanResponse"
      },
      "Restaurant": {
        "properties": {
          "name_local": {
            "type": "string",
            "title": "Name Local",
            "description": "사진에서 읽은 가게 이름 원문. 없으면 빈 문자열."
          },
          "name_translated": {
            "type": "string",
            "title": "Name Translated",
            "description": "한국어 표기. 없으면 빈 문자열."
          },
          "cuisine_hint": {
            "type": "string",
            "title": "Cuisine Hint",
            "description": "음식 종류 한 마디. 예: '오키나와 가정식'. 모르면 빈 문자열."
          }
        },
        "type": "object",
        "required": [
          "name_local",
          "name_translated",
          "cuisine_hint"
        ],
        "title": "Restaurant"
      },
      "ScanMeta": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "image_px": {
            "type": "string",
            "title": "Image Px"
          }
        },
        "type": "object",
        "required": [
          "model",
          "latency_ms",
          "image_px"
        ],
        "title": "ScanMeta"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}