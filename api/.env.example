# Google AI Studio 에서 발급 (https://aistudio.google.com/apikey)
# Vertex AI 는 필요 없다. 무료 티어 쿼터는 API 키가 아니라 '프로젝트' 단위다.
GEMINI_API_KEY=

# 로컬 개발에서만 켠다. 업스트림 원문 에러를 응답에 함께 실어 디버깅을 빠르게 한다.
# 끄더라도 서버 로그에는 항상 남는다. Cloud Run 에서는 설정하지 말 것.
DIPEAT_DEBUG_ERRORS=true

# 선택 — 기본값은 app/core/config.py 참고
# 1차는 싸고 빠른 Flash-Lite, 못 읽으면 폴백으로 상위 모델에 올라간다.
# DIPEAT_GEMINI_MODEL=gemini-3.1-flash-lite
# DIPEAT_GEMINI_MODEL_FALLBACK=gemini-3.5-flash
# minimal | low | medium | high  (기본값 high 를 그대로 두면 지연·비용이 크게 는다)
# DIPEAT_GEMINI_THINKING_LEVEL=low
# 빈 값이면 전송하지 않는다. 미지원 모델에 보내면 400 이 난다.
# DIPEAT_GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# list[str] 는 JSON 으로 파싱된다. 콤마 구분이 아니다.
# DIPEAT_CORS_ORIGINS=["http://localhost:5173","https://dipeat.vercel.app"]
